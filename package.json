{
  "name": "bun-as-vite",
  "version": "1.0.2",
  "description": "Run Vite-configured React and web apps on Bun natively with zero config rewrite. Full drop-in replacement for Vite defineConfig with Bun.build and Bun.serve.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "bun-as-vite": "./bin/bun-as-vite.js",
    "bav": "./bin/bun-as-vite.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./code-split": {
      "types": "./dist/plugins/codeSplit.d.ts",
      "import": "./dist/plugins/codeSplit.js"
    },
    "./proxy-redirects": {
      "types": "./dist/plugins/proxyRedirects.d.ts",
      "import": "./dist/plugins/proxyRedirects.js"
    },
    "./custom-config": {
      "types": "./dist/plugins/customConfig.d.ts",
      "import": "./dist/plugins/customConfig.js"
    },
    "./env-loader": {
      "types": "./dist/plugins/envLoader.d.ts",
      "import": "./dist/plugins/envLoader.js"
    },
    "./build-scorer": {
      "types": "./dist/plugins/buildScorer.d.ts",
      "import": "./dist/plugins/buildScorer.js"
    },
    "./tailwindcss": {
      "types": "./dist/plugins/tailwindcss.d.ts",
      "import": "./dist/plugins/tailwindcss.js"
    },
    "./legacy-config": {
      "types": "./dist/plugins/legacyConfig.d.ts",
      "import": "./dist/plugins/legacyConfig.js"
    },
    "./public-css-manage": {
      "types": "./dist/plugins/publicCssManage.d.ts",
      "import": "./dist/plugins/publicCssManage.js"
    },
    "./build-log-modifier": {
      "types": "./dist/plugins/buildLogModifier.d.ts",
      "import": "./dist/plugins/buildLogModifier.js"
    },
    "./bun-plugin": {
      "types": "./dist/plugins/bunPlugin.d.ts",
      "import": "./dist/plugins/bunPlugin.js"
    },
    "./plugins": {
      "types": "./dist/plugins/index.d.ts",
      "import": "./dist/plugins/index.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js"
    }
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly",
    "prepublish": "rm -rf ./dist && bun run build",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "bun",
    "vite",
    "defineConfig",
    "bun-build",
    "bun-serve",
    "hmr",
    "react-refresh",
    "react-compiler",
    "proxy",
    "code-splitting",
    "tailwindcss"
  ],
  "author": "Yathin",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yathink3/bun-as-vite.git"
  },
  "bugs": {
    "url": "https://github.com/yathink3/bun-as-vite/issues"
  },
  "homepage": "https://github.com/yathink3/bun-as-vite#readme",
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0",
    "vite": "^8.0.0"
  }
}
